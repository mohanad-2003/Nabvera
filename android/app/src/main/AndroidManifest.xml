<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required for Firebase Auth and calls to the backend API. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Required for the biometric-unlock option (local_auth). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- Required on Android 13+ (API 33) to actually show local workout-
         reminder notifications (flutter_local_notifications); requested at
         runtime, not just declared — see workout_reminder_scheduler.dart. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Lets a scheduled reminder survive a device reboot. Only useful
         alongside the boot receiver below — without it, reminders are
         still re-synced every time the app is opened (see
         `syncWorkoutReminders`), just not while the phone stays off. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Deliberately NOT requesting SCHEDULE_EXACT_ALARM/USE_EXACT_ALARM:
         reminders are scheduled inexact (see AndroidScheduleMode in
         workout_reminder_scheduler.dart) so no extra "Alarms & reminders"
         permission screen is ever shown to the user for a fitness reminder. -->

    <!-- Health Connect (Phase 7) — steps/active-minutes-or-calories/sleep
         only, and only ever requested at runtime when the user opts in on
         the Health Connection screen (see health_onboarding_page.dart);
         declaring these here does not grant them. No heart rate, no
         location, no other body/vitals data. -->
    <uses-permission android:name="android.permission.health.READ_STEPS"/>
    <uses-permission android:name="android.permission.health.READ_EXERCISE"/>
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED"/>
    <uses-permission android:name="android.permission.health.READ_SLEEP"/>
    <!-- Health Connect's Steps/Exercise data lives behind the Activity
         Recognition API on Android — requested at runtime via
         permission_handler right before the first Health Connect
         permission request, not on app launch. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION"/>

    <application
        android:label="Nabvera"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Lets Health Connect show its permissions screen for this app. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
            <!-- App Link for the password-reset "continue URL"
                 (https://fitness-app-fitbody-604e8.web.app/reset-complete —
                 see FirebaseAuthService.sendPasswordResetEmail and
                 AppRoutes.resetComplete). Deliberately NOT autoVerify="true":
                 that requires assetlinks.json's SHA-256 to match this
                 build's actual signing cert, and the release build
                 currently still signs with the debug key as a placeholder
                 (see android/app/build.gradle.kts's release buildType) —
                 turn autoVerify on only once a real release signing config
                 and its matching SHA-256 are in
                 firebase-hosting/.well-known/assetlinks.json. Until then,
                 tapping the link shows Android's normal app-picker instead
                 of opening Nabvera automatically. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="fitness-app-fitbody-604e8.web.app"
                    android:pathPrefix="/reset-complete" />
            </intent-filter>
        </activity>
        <!-- Health Connect's permissions screen links back to this app's
             privacy policy — required to pass Google's review when
             requesting sensitive health permissions. Routes to MainActivity,
             which should surface the privacy policy (Profile > Privacy >
             Privacy Policy already exists in-app); point this at a
             dedicated deep link before release if that page isn't reachable
             without first signing in. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- flutter_local_notifications: fires a scheduled reminder and
             re-schedules any still-pending ones after a reboot. Both
             exported="false" — nothing outside this app ever triggers them
             directly. -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Lets the app detect whether the Health Connect app is
             installed (health_service.dart's isPlatformAvailable) and show
             its permissions-rationale flow — never blocks app usage if
             it's missing, see HealthOnboardingPage's "not available" state. -->
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>
</manifest>
